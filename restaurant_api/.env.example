# ──────────────────────────────────────────────────────────────────────────
# Restaurant API — environment configuration.
# Copy to `.env` at the repo root (or in restaurant_api/) and edit as needed.
# All keys prefixed with RESTO_ are picked up by Pydantic Settings.
# ──────────────────────────────────────────────────────────────────────────

# ─── App ────────────────────────────────────────────────────────────────
RESTO_ENV=dev
RESTO_DEBUG=true
RESTO_APP_NAME=Restaurant API
RESTO_LOG_LEVEL=INFO

# ─── Database ──────────────────────────────────────────────────────────
RESTO_DB_HOST=localhost
RESTO_DB_PORT=5432
RESTO_DB_USER=resto
RESTO_DB_PASSWORD=resto_dev_password
RESTO_DB_NAME=resto_dev
RESTO_DB_ECHO=false
RESTO_DB_POOL_SIZE=10
RESTO_DB_MAX_OVERFLOW=20

# ─── Redis ─────────────────────────────────────────────────────────────
RESTO_REDIS_HOST=localhost
RESTO_REDIS_PORT=6379
RESTO_REDIS_DB=0

# ─── Multi-tenancy ─────────────────────────────────────────────────────
# Leave false for MVP single-store. Flip to true in Phase 2 once auth is wired.
RESTO_MULTI_TENANT_ENABLED=false
RESTO_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# ─── Locale ────────────────────────────────────────────────────────────
RESTO_DEFAULT_TIMEZONE=Asia/Taipei
RESTO_DEFAULT_CURRENCY=TWD
