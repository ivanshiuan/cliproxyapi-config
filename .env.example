# ──────────────────────────────────────────────────────────────────────────
# DevSwarm — environment variables
# Copy this file to `.env` and fill in your secrets. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────────

# Required: Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: model overrides (defaults baked into devswarm/config.py)
# DEVSWARM_MODEL_PM=claude-opus-4-7
# DEVSWARM_MODEL_ARCHITECT=claude-opus-4-7
# DEVSWARM_MODEL_CODER=claude-sonnet-4-6
# DEVSWARM_MODEL_REVIEWER=claude-opus-4-7
# DEVSWARM_MODEL_QA=claude-haiku-4-5-20251001

# Optional: self-heal loop limit (default 5)
# DEVSWARM_MAX_HEAL_ITERS=5

# Optional: adversarial review loop limit (default 3)
# DEVSWARM_MAX_REVIEW_ITERS=3

# Optional: Hermes outbound notification channel — console | stub | none (default console)
# DEVSWARM_NOTIFY=console

# Optional: workspace root (default ./workspace)
# DEVSWARM_WORKSPACE_ROOT=./workspace

# Optional: sandbox pytest timeout in seconds (default 60)
# DEVSWARM_SANDBOX_TIMEOUT=60

# ──────────────────────────────────────────────────────────────────────────
# Restaurant API — 店長後台 (admin console) auth
# The wheel-spin marketing console (/demo/admin.html) + its management /
# counter endpoints are gated by a single shared passcode. Both default to
# obvious dev values in restaurant_api/config.py and MUST be overridden in
# production. Generate the session secret with e.g. `openssl rand -hex 32`.
# ──────────────────────────────────────────────────────────────────────────
# RESTO_ADMIN_PASSCODE=change-me-to-a-store-passcode
# RESTO_SESSION_SECRET=change-me-to-a-long-random-string
# RESTO_ADMIN_SESSION_TTL_SECONDS=43200   # optional; default 12h

# ──────────────────────────────────────────────────────────────────────────
# LINE Messaging API (real push notifications)
# Set the channel access token to switch from the in-memory stub to the real
# LINE Messaging API. Get it from the LINE Developers console:
#   https://developers.line.biz/console/  →  your Messaging API channel
#   →  "Messaging API" tab  →  "Channel access token (long-lived)"  →  Issue.
# The secret is OPTIONAL — only needed later for inbound webhook signatures.
# Note: these use the LINE-standard names (no RESTO_ prefix) on purpose.
# Verify with:  .venv/bin/python scripts/line_check.py <your-line-user-id>
# ──────────────────────────────────────────────────────────────────────────
# LINE_CHANNEL_ACCESS_TOKEN=paste-your-long-lived-channel-access-token
# LINE_CHANNEL_SECRET=optional-channel-secret-for-webhooks

# ──────────────────────────────────────────────────────────────────────────
# BUFF OS — embedding backend + LLM model
#   RESTO_EMBED_BACKEND selects which embedding provider the pipeline uses.
#   * openai  → efficient tier (recommended); text-embedding-3-small @ 1536d
#   * voyage  → pro tier; voyage-3-large @ 2048d Matryoshka-sliced to 1536
#   * local   → free tier (zero API cost); hash-based placeholder — swap
#              to sentence-transformers when you want real semantics
#   * fake    → tests only; deterministic pseudo-random vectors
#
# Cloud backends require the matching API key. Local / fake need none.
# ──────────────────────────────────────────────────────────────────────────
# RESTO_EMBED_BACKEND=openai
# RESTO_EMBED_MODEL=text-embedding-3-small
# RESTO_EMBED_MODEL_VERSION=v1

# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...

# LLM model for daily briefs. Defaults to claude-sonnet-5 (cost-effective).
# Use claude-opus-4-8 when you want higher-quality briefs. Prompt cache
# is ON by default and gives ~90% cost reduction on repeated runs.
# RESTO_LLM_MODEL=claude-sonnet-5
# RESTO_LLM_MAX_OUTPUT_TOKENS=4096
# RESTO_LLM_PROMPT_CACHE=true
